# Frontend URL used in verification and notification links
FRONTEND_URL=http://localhost:5173

# Gmail API over HTTPS (recommended for Render free services)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_FROM_EMAIL=your-sender@gmail.com
GMAIL_FROM_NAME=Sunrise Parking

# Optional: number of temporary QR cards created with every new building
DEFAULT_TEMP_QR_CARD_COUNT=20

# Optional local SMTP fallback. Gmail API is used first when fully configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
