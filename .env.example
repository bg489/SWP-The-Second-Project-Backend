# Frontend URL used in verification and notification links
FRONTEND_URL=http://localhost:5173

# Gmail API over HTTPS (recommended for Render free services)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
GMAIL_FROM_EMAIL=your-sender@gmail.com
GMAIL_FROM_NAME=Sunrise Parking

# eSMS Vietnam over HTTPS. Sandbox=true only validates and does not deliver.
ESMS_API_KEY=your-esms-api-key
ESMS_SECRET_KEY=your-esms-secret-key
ESMS_BRANDNAME=
ESMS_SMS_TYPE=8
ESMS_SANDBOX=false
ESMS_TIMEOUT_MS=10000
# Local development only. Never enable this when real delivery is expected.
ESMS_ALLOW_PREVIEW=false

# Optional: number of temporary QR cards created with every new building
DEFAULT_TEMP_QR_CARD_COUNT=20

# FastALPR runs locally on the backend. It does not require an API key.
FAST_ALPR_MIN_CONFIDENCE=72
FAST_ALPR_TIMEOUT_MS=60000
FAST_ALPR_THREADS=1
FAST_ALPR_DETECTOR_CONFIDENCE=0.4
FAST_ALPR_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
FAST_ALPR_OCR_MODEL=cct-xs-v2-global-model

# Optional overrides. Leave blank to use python/python3 and the local model cache.
# FAST_ALPR_PYTHON_BIN=python3
# FAST_ALPR_MODEL_CACHE=/opt/render/project/src/.fast-alpr-models

# Optional local SMTP fallback. Gmail API is used first when fully configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
